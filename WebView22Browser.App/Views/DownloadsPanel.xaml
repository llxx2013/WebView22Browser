<UserControl x:Class="WebView22Browser.App.Views.DownloadsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WebView22Browser.App.ViewModels">
    <UserControl.Resources>
        <DataTemplate x:Key="DownloadItemTemplate" DataType="{x:Type vm:DownloadItemViewModel}">
            <Border Padding="4" Margin="0,0,0,6" BorderBrush="#DDD" BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding SourceUrl}"
                               Foreground="Gray"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding SourceUrl}"/>
                    <ProgressBar Height="8"
                                 Margin="0,4,0,2"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding Progress, TargetNullValue=0}"
                                 IsIndeterminate="{Binding IsProgressIndeterminate}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ProgressText}" FontSize="11" Foreground="Gray"/>
                        <TextBlock Text="{Binding SpeedText}"
                                   FontSize="11"
                                   Foreground="Gray"
                                   Margin="8,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="暂停"
                                Padding="6,2"
                                Margin="0,0,4,0"
                                Command="{Binding PauseCommand}"/>
                        <Button Content="继续"
                                Padding="6,2"
                                Margin="0,0,4,0"
                                Command="{Binding ResumeCommand}"/>
                        <Button Content="取消"
                                Padding="6,2"
                                Margin="0,0,4,0"
                                Command="{Binding CancelCommand}"/>
                        <Button Content="在文件夹中显示"
                                Padding="6,2"
                                Margin="0,0,4,0"
                                Command="{Binding ShowInFolderCommand}"/>
                        <Button Content="打开"
                                Padding="6,2"
                                Margin="0,0,4,0"
                                Command="{Binding OpenCommand}"/>
                        <Button Content="移除"
                                Padding="6,2"
                                Command="{Binding RemoveFromHistoryCommand}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Border BorderBrush="#CCC" BorderThickness="0,1,0,0" Background="#F8F8F8">
        <DockPanel Margin="8">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="下载中心" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Content="折叠"
                        Margin="8,0,0,0"
                        Padding="6,2"
                        Command="{Binding TogglePanelCommand}"/>
                <Button Content="清除已完成"
                        Margin="8,0,0,0"
                        Padding="6,2"
                        Command="{Binding ClearCompletedCommand}"/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="160">
                <StackPanel>
                    <TextBlock Text="进行中" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding ActiveItems}"
                                  ItemTemplate="{StaticResource DownloadItemTemplate}"
                                  Margin="0,0,0,8"/>

                    <TextBlock Text="已完成" FontWeight="SemiBold" Margin="0,4,0,4"/>
                    <ItemsControl ItemsSource="{Binding HistoryItems}"
                                  ItemTemplate="{StaticResource DownloadItemTemplate}"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
