<UserControl x:Class="WebView22Browser.App.Views.UserScriptsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border BorderBrush="#CCC" BorderThickness="1,0,0,0" Background="#F5F5F5">
        <DockPanel Margin="8">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="用户脚本" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Content="折叠"
                            Margin="8,0,0,0"
                            Padding="6,2"
                            Command="{Binding TogglePanelCommand}"/>
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="#666"/>
            </StackPanel>
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button Content="添加…"
                        Padding="6,4"
                        Margin="0,0,4,4"
                        Command="{Binding AddCommand}"/>
                <Button Content="导入 .user.js…"
                        Padding="6,4"
                        Margin="0,0,4,4"
                        Command="{Binding ImportFromFileCommand}"/>
                <Button Content="检查扩展冲突"
                        Padding="6,4"
                        Margin="0,0,4,4"
                        Command="{Binding CheckConflictsCommand}"/>
                <Button Content="重载"
                        Padding="6,4"
                        Margin="0,0,4,4"
                        Command="{Binding ReloadCommand}"/>
                <Button Content="打开配置目录"
                        Padding="6,4"
                        Margin="0,0,4,4"
                        Command="{Binding OpenConfigFolderCommand}"/>
            </WrapPanel>
            <ListBox ItemsSource="{Binding Items}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="2" Margin="0,0,0,4">
                            <StackPanel>
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right"
                                              Content="启用"
                                              IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                              Command="{Binding DataContext.ToggleEnabledCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <TextBlock Text="{Binding MatchSummary}"
                                           FontSize="10"
                                           Foreground="#888"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,2,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding RunAtSummary}"
                                               FontSize="10"
                                               Foreground="#666"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding TopFrameLabel}"
                                               FontSize="10"
                                               Foreground="#666"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="编辑"
                                            Padding="8,2"
                                            Margin="0,0,4,0"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="删除"
                                            Padding="8,2"
                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
