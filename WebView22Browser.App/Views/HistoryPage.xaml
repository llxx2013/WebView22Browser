<UserControl x:Class="WebView22Browser.App.Views.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WebView22Browser.App.ViewModels">
    <UserControl.Resources>
        <DataTemplate x:Key="HistoryEntryTemplate" DataType="{x:Type vm:HistoryEntryViewModel}">
            <Border Padding="8,6" Margin="0,0,0,2" Background="Transparent" Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick"
                                  Command="{Binding DataContext.OpenEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"/>
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Title}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Url}"
                                   Foreground="Gray"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Url}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding TimeText}"
                               Foreground="Gray"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="12,0,8,0"/>
                    <Button Grid.Column="2"
                            Content="×"
                            Width="24"
                            Padding="0"
                            VerticalAlignment="Center"
                            Command="{Binding DataContext.RemoveEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="White">
        <DockPanel Margin="16">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="历史记录"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="清除全部"
                            Margin="8,0,8,0"
                            Padding="8,4"
                            Command="{Binding ClearAllCommand}"/>
                    <Button Grid.Column="2"
                            Content="返回"
                            Padding="8,4"
                            Command="{Binding ClosePageCommand}"/>
                </Grid>
                <Grid Margin="0,12,0,0">
                    <TextBox Padding="8,6"
                             VerticalContentAlignment="Center"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="搜索历史记录"
                               Foreground="#999999"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </StackPanel>

            <TextBlock DockPanel.Dock="Top"
                       Text="无匹配的历史记录"
                       Foreground="Gray"
                       HorizontalAlignment="Center"
                       Margin="0,24,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasNoResults}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding GroupedEntries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:HistoryGroupViewModel}">
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="{Binding Label}"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding Items}"
                                              ItemTemplate="{StaticResource HistoryEntryTemplate}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
