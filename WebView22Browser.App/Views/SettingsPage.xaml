<UserControl x:Class="WebView22Browser.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WebView22Browser.App.ViewModels"
             Visibility="Collapsed">
    <Border Background="White">
        <DockPanel Margin="16">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="设置"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="保存"
                            Margin="8,0,8,0"
                            Padding="8,4"
                            Command="{Binding SaveCommand}"/>
                    <Button Grid.Column="2"
                            Content="恢复默认"
                            Margin="0,0,8,0"
                            Padding="8,4"
                            Command="{Binding ResetToDefaultsCommand}"/>
                    <Button Grid.Column="3"
                            Content="返回"
                            Padding="8,4"
                            Command="{Binding ClosePageCommand}"/>
                </Grid>
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="Green"
                           FontSize="12"
                           Margin="0,8,0,0"/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <GroupBox Header="常规" Margin="0,0,0,12" Padding="12">
                        <StackPanel>
                            <TextBlock Text="主页地址"/>
                            <TextBox Text="{Binding HomeUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,4,0,8"/>
                            <TextBlock Text="搜索地址模板（须包含 {0}）"/>
                            <TextBox Text="{Binding SearchUrlTemplate, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,4,0,8"/>
                            <CheckBox Content="启动时恢复上次会话"
                                      IsChecked="{Binding RestoreLastSession}"/>
                            <TextBlock Text="此项在下次启动浏览器时生效。"
                                       Foreground="Gray"
                                       FontSize="11"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="标签休眠" Margin="0,0,0,12" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="闲置超时（分钟，0 禁用）"/>
                                <TextBox Text="{Binding TabSleepTimeoutMinutes, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="扫描间隔（秒）"/>
                                <TextBox Text="{Binding TabSleepCheckIntervalSeconds, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="每标签历史栈上限"/>
                                <TextBox Text="{Binding TabHistoryMaxEntries, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="性能压力" Margin="0,0,0,12" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Elevated 内存 %"/>
                                <TextBox Text="{Binding PressureElevatedMemoryPercent, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="High 内存 %"/>
                                <TextBox Text="{Binding PressureHighMemoryPercent, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="High CPU %"/>
                                <TextBox Text="{Binding PressureHighCpuPercent, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="采样窗口（秒）"/>
                                <TextBox Text="{Binding PressureSampleWindowSeconds, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="历史上限" Margin="0,0,0,12" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="浏览历史上限"/>
                                <TextBox Text="{Binding BrowsingHistoryMaxEntries, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="下载历史上限"/>
                                <TextBox Text="{Binding DownloadHistoryMaxEntries, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="隐私" Margin="0,0,0,12" Padding="12">
                        <StackPanel>
                            <TextBlock Text="清除 WebView2 Profile 中的 Cookie、磁盘缓存与浏览/下载历史。"
                                       TextWrapping="Wrap"
                                       Foreground="Gray"
                                       FontSize="11"
                                       Margin="0,0,0,8"/>
                            <Button Content="清除浏览数据"
                                    HorizontalAlignment="Left"
                                    Padding="8,4"
                                    Command="{Binding ClearBrowsingDataCommand}"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="数据位置（只读）" Margin="0,0,0,12" Padding="12">
                        <ItemsControl ItemsSource="{Binding DataPaths}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SettingsPathItemViewModel}">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Label}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Path}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Path}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,8,0"
                                                   Foreground="Gray"
                                                   FontSize="11"/>
                                        <Button Grid.Column="2"
                                                Content="打开"
                                                Padding="6,2"
                                                Command="{Binding DataContext.OpenDataPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </GroupBox>

                    <GroupBox Header="关于" Padding="12">
                        <StackPanel>
                            <TextBlock Text="应用程序版本"/>
                            <TextBlock Text="{Binding AppVersion}"
                                       Foreground="Gray"
                                       FontSize="11"
                                       Margin="0,4,0,12"/>
                            <TextBlock Text="WebView2 Runtime 版本"/>
                            <TextBlock Text="{Binding WebView2RuntimeVersion}"
                                       Foreground="Gray"
                                       FontSize="11"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
