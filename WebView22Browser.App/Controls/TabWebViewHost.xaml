<UserControl x:Class="WebView22Browser.App.Controls.TabWebViewHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">
    <Grid>
        <wv2:WebView2 x:Name="webView" Visibility="Collapsed"/>

        <Grid x:Name="skeletonPanel"
              Visibility="Visible"
              Background="#F5F5F5">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        MaxWidth="480"
                        Margin="24">
                <TextBlock Text="{Binding Tab.Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Tab.Address, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Margin="0,8,0,0"
                           FontSize="13"
                           Foreground="#666666"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="skeletonLoadingStatus"
                           Text="{Binding Tab.LoadingStatus, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Margin="0,16,0,0"
                           FontSize="13"
                           Foreground="#888888"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
                <ProgressBar x:Name="skeletonProgress"
                             Width="280"
                             Height="4"
                             Margin="0,12,0,0"
                             IsIndeterminate="True">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Tab.IsLoading, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                        <Condition Binding="{Binding Tab.IsSleeping, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
                <TextBlock Text="标签页已休眠"
                           Margin="0,12,0,0"
                           FontSize="12"
                           Foreground="#AAAAAA"
                           HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tab.IsSleeping, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Grid>

        <Grid x:Name="navigationBarPanel"
              Visibility="Collapsed"
              VerticalAlignment="Top"
              Background="Transparent"
              IsHitTestVisible="False">
            <StackPanel>
                <ProgressBar x:Name="navigationProgress"
                             Height="3"
                             IsIndeterminate="True"/>
                <TextBlock x:Name="navigationBarStatus"
                           Text="{Binding Tab.LoadingStatus, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Margin="8,4,8,0"
                           FontSize="11"
                           Foreground="#666666"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
