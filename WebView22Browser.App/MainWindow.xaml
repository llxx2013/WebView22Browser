<Window x:Class="WebView22Browser.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WebView22Browser.App.Controls"
        xmlns:views="clr-namespace:WebView22Browser.App.Views"
        xmlns:vm="clr-namespace:WebView22Browser.App.ViewModels"
        xmlns:converters="clr-namespace:WebView22Browser.App.Converters"
        x:Name="browserWindow"
        Title="{Binding WindowTitle}"
        Height="700"
        Width="1100"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityInverted" Invert="True"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="favoritesColumn" Width="0"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="userScriptsColumn" Width="0"/>
            <ColumnDefinition x:Name="extensionsColumn" Width="0"/>
        </Grid.ColumnDefinitions>

        <views:FavoritesPanel Grid.Column="0"
                              DataContext="{Binding Favorites}"/>

        <DockPanel Grid.Column="1">
            <ListBox DockPanel.Dock="Top"
                     Margin="4,4,4,0"
                     ItemsSource="{Binding Tabs}"
                     SelectedItem="{Binding SelectedTab}"
                     BorderThickness="0,0,0,1"
                     Background="Transparent">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="Margin" Value="0,0,2,0"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:BrowserTabViewModel}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💤"
                                       Margin="0,0,4,0"
                                       VerticalAlignment="Center"
                                       Opacity="0.7"
                                       ToolTip="标签页已休眠">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSleeping}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock VerticalAlignment="Center" MaxWidth="160" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding Title}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSleeping}" Value="True">
                                                <Setter Property="Foreground" Value="Gray"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Content="×"
                                    Margin="6,0,0,0"
                                    Padding="4,0"
                                    Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid DockPanel.Dock="Top" Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="后退" Width="60" Margin="0,0,4,0"
                        Command="{Binding GoBackCommand}"/>
                <Button Grid.Column="1" Content="前进" Width="60" Margin="0,0,4,0"
                        Command="{Binding GoForwardCommand}"/>
                <Button Grid.Column="2" Content="刷新" Width="60" Margin="0,0,4,0"
                        Command="{Binding ReloadCommand}"/>
                <Button Grid.Column="3" Content="停止" Width="60" Margin="0,0,4,0"
                        Command="{Binding StopCommand}"
                        IsEnabled="{Binding SelectedTab.IsLoading}"/>
                <Button Grid.Column="4" Content="主页" Width="60" Margin="0,0,4,0"
                        Command="{Binding GoHomeCommand}"/>
                <Button Grid.Column="5" Content="☆ 收藏" Width="72" Margin="0,0,4,0"
                        Command="{Binding AddFavoriteCommand}"/>
                <TextBox Grid.Column="6"
                         Margin="0,0,4,0"
                         VerticalContentAlignment="Center"
                         Text="{Binding SelectedTab.Address, UpdateSourceTrigger=LostFocus}"
                         IsEnabled="{Binding IsToolbarEnabled}"
                         KeyDown="AddressBar_KeyDown"
                         GotFocus="AddressBar_GotFocus"/>
                <Button Grid.Column="7" Content="转到" Width="60" Margin="0,0,4,0"
                        Command="{Binding NavigateCommand}"/>
                <Button Grid.Column="8" Content="收藏夹" Width="72" Margin="0,0,4,0"
                        Command="{Binding Favorites.TogglePanelCommand}"/>
                <Button Grid.Column="9" Width="72" Margin="0,0,4,0"
                        Command="{Binding Downloads.TogglePanelCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="下载" VerticalAlignment="Center"/>
                        <Border Background="#D32F2F"
                                CornerRadius="8"
                                Padding="4,0"
                                Margin="4,0,0,0"
                                MinWidth="16"
                                VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Downloads.HasActiveDownloads}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Downloads.ActiveCount}"
                                       Foreground="White"
                                       FontSize="10"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Button>
                <Button Grid.Column="10" Content="历史记录" Width="80" Margin="0,0,4,0"
                        Command="{Binding History.TogglePageCommand}"/>
                <Button Grid.Column="11" Content="用户脚本" Width="80" Margin="0,0,4,0"
                        Command="{Binding UserScripts.TogglePanelCommand}"/>
                <Button Grid.Column="12" Content="扩展程序" Width="80"
                        Command="{Binding Extensions.TogglePanelCommand}"/>
            </Grid>

            <views:DownloadsPanel x:Name="downloadsPanel"
                                  DockPanel.Dock="Bottom"
                                  Height="0"
                                  DataContext="{Binding Downloads}"/>

            <StatusBar DockPanel.Dock="Bottom">
                <StatusBarItem>
                    <TextBlock Text="{Binding StatusMessage}"/>
                </StatusBarItem>
            </StatusBar>

            <Grid Margin="4">
                <ItemsControl x:Name="browserTabsHost"
                              ItemsSource="{Binding Tabs}"
                              Visibility="{Binding History.IsPageOpen, Converter={StaticResource BoolToVisibilityInverted}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Grid/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BrowserTabViewModel}">
                            <controls:TabWebViewHost Tab="{Binding}"
                                                       Environment="{Binding ElementName=browserWindow, Path=WebViewEnvironment}"
                                                       Loaded="TabHost_Loaded"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <views:HistoryPage DataContext="{Binding History}"
                                   Visibility="{Binding IsPageOpen, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </DockPanel>

        <views:UserScriptsPanel Grid.Column="2"
                                DataContext="{Binding UserScripts}"/>

        <views:ExtensionsPanel Grid.Column="3"
                               DataContext="{Binding Extensions}"/>
    </Grid>
</Window>
