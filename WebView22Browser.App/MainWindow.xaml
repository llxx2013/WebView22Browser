<Window x:Class="WebView22Browser.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WebView22Browser.App.Controls"
        xmlns:views="clr-namespace:WebView22Browser.App.Views"
        xmlns:vm="clr-namespace:WebView22Browser.App.ViewModels"
        xmlns:converters="clr-namespace:WebView22Browser.App.Converters"
        x:Name="browserWindow"
        Title="{Binding WindowTitle}"
        Height="700"
        Width="1100"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityInverted" Invert="True"/>
        <converters:SecurityStateToGlyphConverter x:Key="SecurityStateToGlyph"/>
        <converters:SecurityStateToToolTipConverter x:Key="SecurityStateToToolTip"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="favoritesColumn" Width="0"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="userScriptsColumn" Width="0"/>
            <ColumnDefinition x:Name="extensionsColumn" Width="0"/>
        </Grid.ColumnDefinitions>

        <views:FavoritesPanel Grid.Column="0"
                              DataContext="{Binding Favorites}"/>

        <DockPanel Grid.Column="1">
            <ListBox DockPanel.Dock="Top"
                     Margin="4,4,4,0"
                     ItemsSource="{Binding Tabs}"
                     SelectedItem="{Binding SelectedTab}"
                     BorderBrush="#E0E0E0"
                     BorderThickness="0,0,0,1"
                     Background="Transparent">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource TabItemChromeStyle}"/>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:BrowserTabViewModel}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💤"
                                       Margin="0,0,4,0"
                                       VerticalAlignment="Center"
                                       Opacity="0.7"
                                       ToolTip="标签页已休眠">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSleeping}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock VerticalAlignment="Center" MaxWidth="160" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding Title}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSleeping}" Value="True">
                                                <Setter Property="Foreground" Value="Gray"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Content="×"
                                    Margin="6,0,0,0"
                                    Padding="2,0"
                                    Style="{StaticResource ToolbarIconButtonStyle}"
                                    ToolTip="关闭标签页"
                                    Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid DockPanel.Dock="Top" Margin="4,0,4,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：基础导航 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="←"
                            Style="{StaticResource ToolbarIconButtonStyle}"
                            Margin="0,0,2,0"
                            ToolTip="后退"
                            Command="{Binding GoBackCommand}"/>
                    <Button Content="→"
                            Style="{StaticResource ToolbarIconButtonStyle}"
                            Margin="0,0,2,0"
                            ToolTip="前进"
                            Command="{Binding GoForwardCommand}"/>
                    <Grid Margin="0,0,2,0" Width="32">
                        <Button Content="↻"
                                Style="{StaticResource ToolbarIconButtonStyle}"
                                ToolTip="刷新"
                                Command="{Binding ReloadCommand}"
                                Visibility="{Binding SelectedTab.IsLoading, Converter={StaticResource BoolToVisibilityInverted}}"/>
                        <Button Content="✕"
                                Style="{StaticResource ToolbarIconButtonStyle}"
                                ToolTip="停止"
                                Command="{Binding StopCommand}"
                                Visibility="{Binding SelectedTab.IsLoading, Converter={StaticResource BoolToVisibility}}"/>
                    </Grid>
                    <Button Content="⌂"
                            Style="{StaticResource ToolbarIconButtonStyle}"
                            Margin="0,0,2,0"
                            ToolTip="主页"
                            Command="{Binding GoHomeCommand}"/>
                </StackPanel>

                <!-- 中间：复合地址栏 -->
                <Border Grid.Column="1"
                        Margin="4,0,0,0"
                        Style="{StaticResource AddressBarChromeBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Margin="4,0,2,0"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Text="{Binding SelectedTab.SecurityState, Converter={StaticResource SecurityStateToGlyph}}"
                                   ToolTip="{Binding SelectedTab.SecurityState, Converter={StaticResource SecurityStateToToolTip}}"/>
                        <TextBox Grid.Column="1"
                                 Style="{StaticResource AddressBarTextBoxStyle}"
                                 Text="{Binding SelectedTab.Address, UpdateSourceTrigger=LostFocus}"
                                 IsEnabled="{Binding IsToolbarEnabled}"
                                 KeyDown="AddressBar_KeyDown"
                                 GotFocus="AddressBar_GotFocus"/>
                        <Button Grid.Column="2"
                                Content="☆"
                                Style="{StaticResource ToolbarIconButtonStyle}"
                                MinWidth="28"
                                ToolTip="添加到收藏"
                                Command="{Binding AddFavoriteCommand}"/>
                    </Grid>
                </Border>

                <!-- 右侧：快捷操作 + 更多菜单 -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Margin="4,0,0,0"
                            VerticalAlignment="Center">
                    <Button Content="☰"
                            Style="{StaticResource ToolbarIconButtonStyle}"
                            Margin="0,0,2,0"
                            ToolTip="收藏夹"
                            Command="{Binding Favorites.TogglePanelCommand}"/>
                    <Button Style="{StaticResource ToolbarIconButtonStyle}"
                            Margin="0,0,2,0"
                            ToolTip="下载"
                            Command="{Binding Downloads.TogglePanelCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↓" VerticalAlignment="Center" FontSize="14"/>
                            <Border Background="#D32F2F"
                                    CornerRadius="8"
                                    Padding="4,0"
                                    Margin="2,0,0,0"
                                    MinWidth="16"
                                    VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Downloads.HasActiveDownloads}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Downloads.ActiveCount}"
                                           Foreground="White"
                                           FontSize="10"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button Content="◷"
                            Style="{StaticResource ToolbarIconButtonStyle}"
                            Margin="0,0,2,0"
                            ToolTip="历史记录"
                            Command="{Binding History.TogglePageCommand}"/>
                    <Menu Style="{StaticResource ToolbarMenuStyle}">
                        <MenuItem Header="⋯"
                                  ToolTip="更多选项"
                                  Padding="8,4">
                            <MenuItem Header="脚本命令"
                                      IsEnabled="{Binding ScriptCommands.IsMenuEnabled}"
                                      ItemsSource="{Binding ScriptCommands.Items}">
                                <MenuItem.ItemContainerStyle>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Header" Value="{Binding DisplayName}"/>
                                        <Setter Property="Command"
                                                Value="{Binding DataContext.ScriptCommands.RunMenuCommandCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <Setter Property="CommandParameter" Value="{Binding}"/>
                                    </Style>
                                </MenuItem.ItemContainerStyle>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="在页面中查找"
                                      ToolTip="Ctrl+F"
                                      Command="{Binding ShowFindCommand}"/>
                            <MenuItem Header="用户脚本"
                                      Command="{Binding UserScripts.TogglePanelCommand}"/>
                            <MenuItem Header="扩展程序"
                                      Command="{Binding Extensions.TogglePanelCommand}"/>
                            <MenuItem Header="系统设置"
                                      Command="{Binding Settings.TogglePageCommand}"/>
                        </MenuItem>
                    </Menu>
                </StackPanel>
            </Grid>

            <views:DownloadsPanel x:Name="downloadsPanel"
                                  DockPanel.Dock="Bottom"
                                  Height="0"
                                  DataContext="{Binding Downloads}"/>

            <StatusBar DockPanel.Dock="Bottom">
                <StatusBarItem>
                    <TextBlock Text="{Binding TabCountWarning}"
                               Foreground="#C06000"/>
                </StatusBarItem>
                <StatusBarItem>
                    <TextBlock Text="{Binding StatusMessage}"/>
                </StatusBarItem>
            </StatusBar>

            <Grid Margin="4">
                <ItemsControl x:Name="browserTabsHost"
                              ItemsSource="{Binding Tabs}"
                              Visibility="{Binding IsBrowserContentVisible, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Grid/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BrowserTabViewModel}">
                            <controls:TabWebViewHost Tab="{Binding}"
                                                       Environment="{Binding ElementName=browserWindow, Path=WebViewEnvironment}"
                                                       Loaded="TabHost_Loaded"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <views:HistoryPage DataContext="{Binding History}"
                                   Visibility="{Binding IsPageOpen, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed, TargetNullValue=Collapsed}"/>
                <views:SettingsPage DataContext="{Binding Settings}"
                                    Visibility="{Binding IsPageOpen, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed, TargetNullValue=Collapsed}"/>
            </Grid>
        </DockPanel>

        <views:UserScriptsPanel Grid.Column="2"
                                DataContext="{Binding UserScripts}"/>

        <views:ExtensionsPanel Grid.Column="3"
                               DataContext="{Binding Extensions}"/>
    </Grid>
</Window>
